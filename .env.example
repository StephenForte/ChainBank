# ChainBank local configuration (Phase 0)
# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
CHAINBANK_ENVIRONMENT=local
LOG_LEVEL=info
PORT=3000
HOST=127.0.0.1
PUBLIC_BASE_URL=http://localhost:3000

# Local Postgres (Postgres.app or Homebrew). No Docker required.
DATABASE_URL=postgres://localhost:5432/chainbank
# Pool ceiling. Signing-capable roles (web, cron-reconciler) require >= 2:
# TX.10 commits the broadcast intent on a second connection while the
# advisory-lock transaction holds the first. Defaults: web=10, monitor=2,
# cron-reconciler=3.
# DATABASE_POOL_MAX=10
# DATABASE_SSL=false
# Required whenever database TLS is enabled (hosted defaults to TLS on).
# Paste the provider CA PEM. Literal \n sequences are accepted.
# DATABASE_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# Ethereum Sepolia only in Phase 0. Mainnet is rejected at startup.
CHAIN_ID=11155111
CHAIN_RPC_URL=https://your-sepolia-rpc.example
# Optional override; defaults to https://sepolia.etherscan.io
# CHAIN_EXPLORER_BASE_URL=https://sepolia.etherscan.io

# Treasury address (checksummed or lowercase). Never put the private key here.
TREASURY_ADDRESS=0xYourTreasuryAddress
# Ladder must satisfy reserve < critical <= warning <= recovery, or the process
# refuses to start. These mirror render.yaml so a local run behaves like hosted.
TREASURY_WARNING_BALANCE_ETH=0.75
TREASURY_CRITICAL_BALANCE_ETH=0.3
TREASURY_RECOVERY_BALANCE_ETH=1.5
TREASURY_MINIMUM_RESERVE_ETH=0.1

# Funding gate. Default false. Enabling requires TREASURY_PRIVATE_KEY on
# signing-capable services (web). The treasury-monitor role never reads the key.
# When false (or FUNDING_KILL_SWITCH=true), ensure-funded returns FUNDING_DISABLED
# without touching the signer.
FUNDING_ENABLED=false
# Emergency stop: blocks all signing while read paths stay up.
FUNDING_KILL_SWITCH=false
# Signing-capable services only. Never set on treasury-monitor.
# TREASURY_PRIVATE_KEY=0xYourDisposableLocalKeyOnly
# Receipt tracking (D4). Timeout leaves the tx pending — never a false failure.
# FUNDING_CONFIRMATIONS=1
# FUNDING_CONFIRMATION_TIMEOUT_MS=60000
# Reserve is TREASURY_MINIMUM_RESERVE_ETH above (enforced on every ensure-funded).

# Email. Use log-only locally if you do not have Resend yet.
# Required for web and treasury-monitor (alert delivery). Never set TREASURY_PRIVATE_KEY on the monitor.
EMAIL_PROVIDER=log-only
EMAIL_FROM_ADDRESS=chainbank@example.com
EMAIL_OPERATOR_RECIPIENTS=you@example.com
# RESEND_API_KEY=re_xxxxxxxx

# Hours between unresolved treasury alert reminder emails (default 24).
# ALERT_REMINDER_INTERVAL_HOURS=24

# Consecutive reconciliation-run failures before operator email (default 3).
# RECONCILE_FAILURE_ALERT_THRESHOLD=3

# Maximum treasury-outgoing blocks scanned per reconciler run (default 20000).
# TX.9: per-run cap with incremental resume from treasuries.last_outgoing_scan_block;
# not "always scan this many blocks". ~1800 covers one 6h Sepolia interval with margin.
# RECONCILE_OUTGOING_LOOKBACK_BLOCKS=20000

# Optional API hardening for local dashboard work
# CORS_ALLOWED_ORIGINS=http://localhost:5173
# RATE_LIMIT_MAX=120
# RATE_LIMIT_WINDOW_SECONDS=60
# Trusted reverse-proxy hops in a hosted environment. Render adds exactly one.
# Raising this without a matching proxy chain lets clients forge their source
# address through X-Forwarded-For.
# TRUSTED_PROXY_HOPS=1

# Bearer token for GET /health/funding (web). Optional at boot; when unset the
# endpoint rejects every request. ForteL2 (or any funding consumer) holds the
# matching secret. Not an API credential — dedicated static token.
# FUNDING_HEALTH_TOKEN=replace-with-long-random-token
